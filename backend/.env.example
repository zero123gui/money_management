# Modelo do arquivo .env do backend. Copie para backend/.env e preencha.
# O .env fica fora do Git; variáveis de ambiente do sistema têm prioridade sobre ele.

# Conexão com o PostgreSQL.
DB_URL=jdbc:postgresql://localhost:5432/financeiro
DB_USERNAME=financeiro_app
DB_PASSWORD=

# Chave de assinatura do JWT: texto aleatório com pelo menos 32 bytes, em Base64.
# Para gerar: openssl rand -base64 48
JWT_SECRET=
# Validade do token no formato ISO 8601 (PT1H = 1 hora).
JWT_EXPIRATION=PT1H

# Falhas seguidas de login que bloqueiam o e-mail, e por quanto tempo (ISO 8601).
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_DURATION=PT15M

# Cadastro restrito à lista de e-mails. Em produção, mantenha true.
# Em testes e homologação, use false para aceitar qualquer e-mail.
SIGNUP_RESTRICTED=true
# E-mails que podem criar conta, separados por vírgula. Ex.: ana@exemplo.com,bia@exemplo.com
SIGNUP_ALLOWED_EMAILS=
