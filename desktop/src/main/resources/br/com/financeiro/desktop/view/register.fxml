<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="br.com.financeiro.desktop.controller.RegisterController"
           styleClass="page">
    <VBox styleClass="card" maxWidth="380" maxHeight="-Infinity" spacing="8">
        <Label text="Criar conta" styleClass="title"/>

        <Label text="Nome" labelFor="$nameField" styleClass="field-label"/>
        <TextField fx:id="nameField"/>

        <Label text="E-mail" labelFor="$emailField" styleClass="field-label"/>
        <TextField fx:id="emailField" promptText="voce@exemplo.com"/>

        <Label text="Senha" labelFor="$passwordField" styleClass="field-label"/>
        <PasswordField fx:id="passwordField" promptText="Mínimo de 8 caracteres"/>

        <Label text="Confirmar senha" labelFor="$confirmationField" styleClass="field-label"/>
        <PasswordField fx:id="confirmationField"/>

        <Label fx:id="errorLabel" visible="false" wrapText="true" styleClass="form-error"/>

        <Button fx:id="registerButton" text="Criar conta" defaultButton="true" maxWidth="Infinity"
                onAction="#onRegister" styleClass="primary-button">
            <VBox.margin>
                <Insets top="8"/>
            </VBox.margin>
        </Button>
        <Hyperlink text="Já tenho uma conta" onAction="#onBackToLogin"/>
    </VBox>
</StackPane>
