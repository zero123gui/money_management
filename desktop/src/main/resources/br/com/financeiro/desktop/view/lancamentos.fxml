<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.financeiro.desktop.controller.LancamentosController"
      styleClass="content" spacing="12">
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Lançamentos" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="deleteButton" text="Excluir" onAction="#onDelete"/>
        <Button fx:id="editButton" text="Editar" onAction="#onEdit"/>
        <Button fx:id="newButton" text="Novo lançamento" onAction="#onNew" styleClass="primary-button"/>
    </HBox>

    <FlowPane hgap="12" vgap="8" rowValignment="BOTTOM">
        <VBox spacing="4">
            <Label text="Início" labelFor="$startPicker" styleClass="field-label"/>
            <DatePicker fx:id="startPicker" prefWidth="140" promptText="dd/mm/aaaa"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Fim" labelFor="$endPicker" styleClass="field-label"/>
            <DatePicker fx:id="endPicker" prefWidth="140" promptText="dd/mm/aaaa"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Tipo" labelFor="$typeBox" styleClass="field-label"/>
            <ComboBox fx:id="typeBox" prefWidth="120"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Categoria" labelFor="$categoryBox" styleClass="field-label"/>
            <ComboBox fx:id="categoryBox" prefWidth="150"/>
        </VBox>
        <Button fx:id="filterButton" text="Filtrar" defaultButton="true" onAction="#onFilter"/>
        <Button fx:id="clearButton" text="Limpar" onAction="#onClearFilters"/>
    </FlowPane>

    <Label fx:id="noticeLabel" visible="false" wrapText="true" styleClass="form-notice"/>
    <Label fx:id="errorLabel" visible="false" wrapText="true" styleClass="form-error"/>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label fx:id="placeholderLabel" styleClass="subtitle"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="dateColumn" text="Data" sortable="false" reorderable="false" prefWidth="90"/>
            <TableColumn fx:id="descriptionColumn" text="Descrição" sortable="false" reorderable="false" prefWidth="240"/>
            <TableColumn fx:id="categoryColumn" text="Categoria" sortable="false" reorderable="false" prefWidth="130"/>
            <TableColumn fx:id="typeColumn" text="Tipo" sortable="false" reorderable="false" prefWidth="80"/>
            <TableColumn fx:id="amountColumn" text="Valor" sortable="false" reorderable="false" prefWidth="120" styleClass="amount-column"/>
        </columns>
    </TableView>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label fx:id="pageLabel" styleClass="subtitle"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="previousButton" text="Anterior" disable="true" onAction="#onPreviousPage"/>
        <Button fx:id="nextButton" text="Próxima" disable="true" onAction="#onNextPage"/>
    </HBox>
</VBox>
