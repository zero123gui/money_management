<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.financeiro.desktop.controller.CategoriaFormController"
      styleClass="card" prefWidth="380" spacing="8">
    <Label fx:id="titleLabel" styleClass="title"/>

    <Label text="Nome" labelFor="$nameField" styleClass="field-label"/>
    <TextField fx:id="nameField"/>

    <Label text="Tipo" labelFor="$typeBox" styleClass="field-label"/>
    <ComboBox fx:id="typeBox" maxWidth="Infinity"/>

    <Label fx:id="errorLabel" visible="false" wrapText="true" minHeight="-Infinity" styleClass="form-error"/>

    <HBox spacing="8" alignment="CENTER_RIGHT">
        <VBox.margin>
            <Insets top="8"/>
        </VBox.margin>
        <Button fx:id="cancelButton" text="Cancelar" cancelButton="true" onAction="#onCancel"/>
        <Button fx:id="saveButton" text="Salvar" defaultButton="true" onAction="#onSave" styleClass="primary-button"/>
    </HBox>
</VBox>
