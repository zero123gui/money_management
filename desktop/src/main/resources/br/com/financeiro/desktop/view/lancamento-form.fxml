<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.financeiro.desktop.controller.LancamentoFormController"
      styleClass="card" prefWidth="420" spacing="8">
    <Label fx:id="titleLabel" styleClass="title"/>

    <Label text="Tipo" labelFor="$typeBox" styleClass="field-label"/>
    <ComboBox fx:id="typeBox" maxWidth="Infinity"/>

    <Label text="Valor (R$)" labelFor="$amountField" styleClass="field-label"/>
    <TextField fx:id="amountField" promptText="1.234,56"/>

    <Label text="Data" labelFor="$datePicker" styleClass="field-label"/>
    <DatePicker fx:id="datePicker" maxWidth="Infinity" promptText="dd/mm/aaaa"/>

    <Label text="Categoria" labelFor="$categoryBox" styleClass="field-label"/>
    <ComboBox fx:id="categoryBox" maxWidth="Infinity" promptText="Selecione"/>

    <Label text="Descrição (opcional)" labelFor="$descriptionField" styleClass="field-label"/>
    <TextField fx:id="descriptionField"/>

    <Label fx:id="errorLabel" visible="false" wrapText="true" minHeight="-Infinity" styleClass="form-error"/>

    <HBox spacing="8" alignment="CENTER_RIGHT">
        <VBox.margin>
            <Insets top="8"/>
        </VBox.margin>
        <Button fx:id="cancelButton" text="Cancelar" cancelButton="true" onAction="#onCancel"/>
        <Button fx:id="saveButton" text="Salvar" defaultButton="true" onAction="#onSave" styleClass="primary-button"/>
    </HBox>
</VBox>
